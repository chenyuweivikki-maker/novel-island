# 复制本文件为 backend/.env 并填入你的密钥
# cp .env.example backend/.env

# ===== DeepSeek（主力模型，必填）=====
# 日常问答/摘要/情感陪伴/意图分类都走它，成本最低
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Moonshot Kimi（高阶模型，可选）=====
# 复杂逻辑纠错/人设深度分析/核心灵感拓展走它（PRD结论：产品接国产高阶模型）
# 使用国内站 api.moonshot.cn 的密钥；不填或余额不足时自动回退 DeepSeek，不影响主流程
MOONSHOT_API_KEY=sk-你的密钥
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# ===== 腾讯混元（高阶模型备选，可选）=====
# 想用混元 HY3 时，把 MODEL_ROUTES["complex"] 改成 hunyuan-turbos-latest 并填入
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbos-latest

# ===== SiliconFlow（Embedding，必填）=====
# 文本向量化（建库/检索）
SILICONFLOW_API_KEY=sk-你的密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Server
HOST=0.0.0.0
PORT=8000
